# Environment Configuration for Durob Al Hijra API
NODE_ENV=development
PORT=4000
# Which address to listen on. 127.0.0.1 behind Nginx; empty listens on every address, which a phone on the same network needs in development.
HOST=

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/durob_db?schema=public"

# Redis (optional in development; required once more than one server instance runs)
# With REDIS_HOST set, live events, rate limits, login locks and signed-out tokens are shared by every instance. If Redis is then unreachable, requests that need it are refused (503) rather than each instance keeping its own copy.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
TICKET_SIGNING_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Encrypts the service keys saved from the panel's settings page. Generated the same way.
# Without it those keys cannot be saved. Changing it makes keys already saved unreadable, so they must be entered again.
SETTINGS_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API. Required in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# true only in development: returns the OTP in the API response until WhatsApp is connected.
OTP_DEV_ECHO=true

# simulated: confirm bookings without collecting money (development only, rejected in production).
# disabled: reject any booking with an amount due until the payment gateway is connected.
PAYMENT_MODE=simulated

# TEMPORARY, for the client's trial on its own database. Remove before real customers and real payments.
# true: production accepts PAYMENT_MODE=simulated (bookings confirm with no money collected), and until WhatsApp is
# connected the login code goes to the notifications of every admin instead of the customer. An admin can therefore
# open any customer account during the trial. OTP_DEV_ECHO stays refused in production.
CLIENT_TRIAL_MODE=false

# How many reverse proxies sit in front of the API (1 behind a single Nginx). Leave 0 when directly exposed: trusting a header no proxy cleans lets callers fake their IP.
TRUST_PROXY_HOPS=0

# Error reporting (optional). With SENTRY_DSN set, server errors (5xx) and failed background jobs are sent to Sentry,
# stripped of auth headers, cookies, tokens, phone numbers and ID numbers. Empty: nothing is sent and @sentry/node is not loaded.
# The mobile app's crashes reach Sentry through POST /api/v1/monitoring/client-errors, so the app needs no DSN of its own.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# e.g. the git commit being deployed, to tell which version an error came from.
SENTRY_RELEASE=
# Share of requests traced for performance (0 to 1). 0 or empty: errors only.
SENTRY_TRACES_SAMPLE_RATE=0
